# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000

# PostgreSQL connection string (e.g. Neon / Render / Supabase / local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/slsea_solar?schema=public"

# Public base URL used when building Location headers and pagination links
PUBLIC_BASE_URL=http://localhost:3000

# Secret for signing SLSEA user access tokens (read path)
JWT_SECRET=change-me
