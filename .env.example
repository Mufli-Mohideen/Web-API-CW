# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000

# MongoDB Atlas (mongodb+srv://<user>:<password>@<cluster>/)
MONGO_USER=
MONGO_PASSWORD=
MONGO_CLUSTER=cluster0.xxxxxxx.mongodb.net
MONGO_DB_NAME=slsea_solar_db
# Optional: a full connection string instead of the three parts above (e.g. a local mongod)
# MONGODB_URI=mongodb://127.0.0.1:27017

# Signs SLSEA user access tokens (read path). Use a long random value in production.
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h

# Seeding only: derives each seeded device's API key, and the demo users' password
DEVICE_KEY_SECRET=change-me-too
SEED_USER_PASSWORD=Slsea@2026
